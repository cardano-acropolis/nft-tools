cabal-version:      3.0
name:               nft-tools
version:            0.1.0.0
synopsis:           Tools for working with and issuing NFTs on Cardano.
homepage:           http://www.jonesfinancial.io/nft-tools
license:            NONE
author:             Noah Jones
maintainer:         noahtjones@gmail.com
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md
extra-source-files:
    get-crypto-libs.sh

-- GHC and Plinth both accept these.
common ghc-options
    ghc-options:        -Wall
    default-language:   Haskell2010
    default-extensions:
        ImportQualifiedPost
        OverloadedStrings

-- Off-chain code. GADTs are not part of the Plinth subset.
common ghc-only-options
    import:             ghc-options
    default-extensions:
        GADTs

-- Flags the Plinth compiler needs in order to see unfoldings. The plugin
-- option selects Plutus Core 1.1.0. plutus-tx-plugin 1.71's default target
-- is Core 1.2.0, which a Plutus V3 script cannot deserialise until the
-- Dijkstra hard fork (major protocol version 12). 1.1.0 is valid from Chang
-- (protocol version 9) onward. The plugin module is Plinth.Plugin;
-- PlutusTx.compile registers it. The pre-1.63 name PlutusTx.Plugin is gone,
-- so a -fplugin-opt aimed at that module would not reach the compiler.
--
-- datatypes=ScottEncoding: the 1.71 default is sums-of-products, which
-- compiles pattern matches to 'case' on built-in types. Casing on Data
-- is rejected until Dijkstra, so that default cannot run on current
-- Conway. Scott encoding uses the older builtins (ifThenElse, chooseData,
-- and so on) and evaluates from Chang.
common plinth-options
    import:             ghc-options
    ghc-options:
        -fobject-code
        -fno-full-laziness
        -fno-ignore-interface-pragmas
        -fno-omit-interface-pragmas
        -fno-spec-constr
        -fno-specialise
        -fno-strictness
        -fno-unbox-small-strict-fields
        -fno-unbox-strict-fields
        -fplugin-opt=Plinth.Plugin:target-version=1.1.0
        -fplugin-opt=Plinth.Plugin:preserve-logging
        -fplugin-opt=Plinth.Plugin:datatypes=ScottEncoding

-- CHaP releases. ^>=1.71 keeps us on the 1.71 line pinned by cabal.project.
common plutus-deps
    build-depends:
        plutus-core ^>=1.71.0.0,
        plutus-ledger-api ^>=1.71.0.0,
        plutus-tx ^>=1.71.0.0,
        plutus-tx-plugin ^>=1.71.0.0

library
    import:           ghc-only-options
    exposed-modules:  MyLib
    build-depends:    base >=4.14 && <5
    hs-source-dirs:   src

-- Off-chain transaction builders. Not compiled with the Plinth plugin:
-- cardano-api 11.7 (the newest release at this CHaP pin) depends on
-- plutus-ledger-api ^>=1.70, which excludes 1.71. cardano-ledger-conway
-- 1.23 (newest at this CHaP pin; 1.24 is dated 2026-10-01) accepts
-- plutus-ledger-api 1.71, so Conway tx bodies are built with that package
-- instead of the archived plutus-apps Contract monad.
library nft-offchain
    import:           ghc-only-options
    visibility:       public
    hs-source-dirs:   offchain
    exposed-modules:  Client
    build-depends:
        base >=4.18 && <5,
        aeson,
        base16-bytestring ^>=1.0,
        bytestring,
        cardano-crypto-class,
        cardano-ledger-allegra,
        cardano-ledger-alonzo,
        cardano-ledger-binary,
        cardano-ledger-conway ^>=1.23.0.0,
        cardano-ledger-core,
        cardano-ledger-mary,
        cardano-strict-containers,
        containers,
        microlens,
        nft-tools:nft-plinth,
        plutus-ledger-api ^>=1.71.0.0,
        plutus-tx ^>=1.71.0.0,
        text

-- On-chain Plutus V3 code. Separate from the library above so the Plinth
-- plugin and its optimisation flags apply only to modules that are compiled
-- to Plutus Core.
library nft-plinth
    import:           plinth-options, plutus-deps
    visibility:       public
    hs-source-dirs:   src
    exposed-modules:
        NFT
        ThreadFamily
        MintingMachine
    build-depends:    base >=4.18 && <5

executable nft-tools
    import:           ghc-only-options
    main-is:          Main.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app

executable generate-vending-machine
    import:           ghc-only-options
    main-is:          generate-vending-machine.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app

executable generate-airdrop
    import:           ghc-only-options
    main-is:          generate-airdrop.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app

executable ticket-sale
    import:           ghc-only-options
    main-is:          ticket-sale.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app

executable write-thread-family
    import:           ghc-only-options
    main-is:          write-thread-family.hs
    hs-source-dirs:   app
    build-depends:
        base >=4.18 && <5,
        base16-bytestring ^>=1.0,
        bytestring,
        nft-tools:nft-plinth,
        plutus-ledger-api ^>=1.71.0.0

executable write-vending-machine
    import:           ghc-only-options
    main-is:          write-vending-machine.hs
    hs-source-dirs:   app
    build-depends:
        base >=4.18 && <5,
        base16-bytestring ^>=1.0,
        bytestring,
        nft-tools:nft-plinth,
        plutus-ledger-api ^>=1.71.0.0,
        text

executable nft-client
    import:           ghc-only-options
    main-is:          nft-client.hs
    hs-source-dirs:   app
    build-depends:
        base >=4.18 && <5,
        aeson,
        base16-bytestring ^>=1.0,
        bytestring,
        containers,
        nft-tools:nft-offchain,
        text

executable write-nft-policy
    import:           ghc-only-options
    main-is:          write-nft-policy.hs
    hs-source-dirs:   app
    build-depends:
        base >=4.18 && <5,
        base16-bytestring ^>=1.0,
        bytestring,
        nft-tools:nft-plinth,
        plutus-ledger-api ^>=1.71.0.0,
        text

test-suite nft-tools-test
    import:           ghc-only-options
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        ClientSpec
        NFTSpec
        ThreadFamilySpec
        VendingSpec
    hs-source-dirs:   test
    build-depends:
        base >=4.18 && <5,
        aeson,
        base16-bytestring ^>=1.0,
        bytestring,
        containers,
        mtl,
        nft-tools:nft-offchain,
        nft-tools:nft-plinth,
        plutus-ledger-api ^>=1.71.0.0,
        plutus-ledger-api:plutus-ledger-api-testlib,
        plutus-tx ^>=1.71.0.0,
        tasty,
        tasty-hunit,
        tasty-quickcheck,
        text
