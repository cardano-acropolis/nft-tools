cabal-version:      3.0
name:               nft-tools
version:            0.1.0.0
synopsis:           Tools for working with and issuing NFTs on Cardano.
homepage:           http://www.jonesfinancial.io/nft-tools
license:            NONE
author:             Noah Jones
maintainer:         noahtjones@gmail.com
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MyLib

    -- Work-in-progress modules, not yet part of the build: they need
    -- the Plutus toolchain (plutus-ledger, cardano-api, plutus-tx),
    -- which must be added via a pinned plutus-apps environment before
    -- they can be listed here.
    --   src/MintingMachine.hs
    --   src/NFT.hs
    --   src/Client.hs

    build-depends:    base >=4.14 && <5
    hs-source-dirs:   src
    default-language: Haskell2010

executable nft-tools
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app
    default-language: Haskell2010

executable generate-vending-machine
    import:           warnings
    main-is:          generate-vending-machine.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app
    default-language: Haskell2010

executable generate-airdrop
    import:           warnings
    main-is:          generate-airdrop.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app
    default-language: Haskell2010

executable ticket-sale
    import:           warnings
    main-is:          ticket-sale.hs
    build-depends:
        base >=4.14 && <5,
        nft-tools
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite nft-tools-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          MyLibTest.hs
    hs-source-dirs:   test
    build-depends:
        base >=4.14 && <5,
        nft-tools
    default-language: Haskell2010
