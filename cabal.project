-- Plinth (PlutusTx) build pin, following IntersectMBO/plinth-template.
--
-- plutus-tx, plutus-tx-plugin, plutus-ledger-api and plutus-core are not on
-- Hackage. CHaP is the repository the Plinth docs tell projects to use.
-- The index-state dates match plinth-template main (checked 2026-10-03) so
-- `cabal build` resolves the same package set that template builds against.
--
-- plutus-tx-plugin 1.71 is buildable only on GHC 9.6.x and GHC 9.12.x.
-- This repo is developed and tested with GHC 9.6.7. Do not set
-- `with-compiler` here: GHC 9.12.x is also a supported compiler, and the
-- plugin package refuses to build on anything else.

repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  -- Bump both of the following dates together when taking newer Hackage
  -- packages. Keep the CHaP line in sync with the plutus version bounds in
  -- nft-tools.cabal. The leading commas are required by cabal.project.
  , hackage.haskell.org 2026-09-29T19:48:01Z
  -- Bump this when taking a newer plutus release from CHaP.
  , cardano-haskell-packages 2026-09-24T00:08:56Z

packages:
  ./.

-- The plugin links against the GHC API and is not built with profiling.
package plutus-tx-plugin
  profiling: False
